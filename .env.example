# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Server-only Supabase secret key: Project Settings -> API (never prefix with NEXT_PUBLIC_).
# Used only to sign the file behind a valid document share link (/d/<token>).
SUPABASE_SECRET_KEY=

# Server-only secret used to hash visitor IPs for Start-a-project rate limiting (32+ random chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Server-only OpenRouter key for the Resume Builder AI (never prefix with NEXT_PUBLIC_).
OPEN_ROUTER_API_KEY=
