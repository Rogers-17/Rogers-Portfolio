# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Server-only Supabase secret key: Project Settings -> API (never prefix with NEXT_PUBLIC_).
# Used only to sign the file behind a valid document share link (/d/<token>).
SUPABASE_SECRET_KEY=

# Server-only secret used to hash visitor IPs for Start-a-project rate limiting (32+ random chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Server-only OpenRouter key for the Resume Builder AI (never prefix with NEXT_PUBLIC_).
OPEN_ROUTER_API_KEY=

# Canonical public origin used for SEO metadata, the sitemap and share links.
# Vercel: set to https://mohammednrogers.online in PRODUCTION ONLY. Leave it unset in Preview
# so preview share links keep their own URL (preview pages are always noindex anyway).
# Must be a valid http(s) URL; an invalid value fails the build.
NEXT_PUBLIC_SITE_URL=

# Indexing is automatic: only Vercel Production (VERCEL_ENV=production, set by Vercel) is
# indexable. Do not set VERCEL_ENV yourself except to test production robots locally.

# Optional, server-only: email the owner when a Start-a-project request is saved (Resend).
# All three must be set, otherwise no email is sent and submissions work exactly as before.
# CONTACT_FROM_EMAIL must use a domain verified in Resend, e.g. "Rogers Portfolio <notifications@mohammednrogers.online>".
# CONTACT_NOTIFY_TO is your inbox (comma-separated for several), e.g. hello@mohammednrogers.online.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_TO=
